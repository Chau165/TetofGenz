    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 0
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 1
    m_LineSpacing: 1
  m_Text: "\u2022 L\u1EADp k\u1EBF ho\u1EA1ch mua s\u1EAFm tr\u01B0\u1EDBc khi ch\u1EE3
    \u0111\xF4ng \u0111\xFAc.\n\u2022 Tr\xF2 chuy\u1EC7n v\u1EDBi ng\u01B0\u1EDDi
    b\xE1n, so s\xE1nh gi\xE1 c\u1EA3 v\xE0 ch\u1ECDn \u0111\xFAng h\xE0ng T\u1EBFt.\n\u2022
    Ho\xE0n th\xE0nh m\xE2m ng\u0169 qu\u1EA3, hoa \u0111\xE0o/mai, th\u1ECBt l\u1EE3n
    v\xE0 gi\u1ECF qu\xE0 tr\u01B0\u1EDBc khi m\u1EB7t tr\u1EDDi l\u1EB7n.\n\u2022
    M\u1ED7i ng\xE0y t\u1EADp trung v\xE0o m\u1ED9t ph\u1EA7n chu\u1EA9n b\u1ECB
    T\u1EBFt kh\xE1c nhau."
