  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 0.9, g: 0.84, b: 0.74, a: 1}
  m_RaycastTarget: 1
