  npcName: "M\u1EB9"
  portrait: {fileID: 0}
  dialogueLines: []
  repeatLines: []
  questIntroLines:
  - "S\u1EAFp T\u1EBFt r\u1ED3i, con gi\xFAp m\u1EB9 \u0111i ch\u1EE3 mua v\xE0i
    m\xF3n nh\xE9."
  - "Nh\xE0 m\xECnh c\u1EA7n b\xE1nh m\u1EE9t, d\u01B0a h\u1EA5u, hoa mai, th\u1ECBt
    heo v\xE0 gi\u1ECF qu\xE0."
  - "M\u1EB9 \u0111\u01B0a con 1.000.000\u0111, nh\u1EDB mua \u0111\u1EE7 nh\u01B0ng
    \u0111\u1EEBng ti\xEAu hoang nha."
  - "Mua xong th\xEC g\u1EEDi \u0111\u1ED3 v\u1EC1 nh\xE0 c\u1EA9n th\u1EADn, \u0111\u01B0\u1EDDng
    h\xF4m nay h\u01A1i \u0111\xF4ng \u0111\xF3."
  questReminderLines:
  - "Con nh\u1EDB mua \u0111\u1EE7 \u0111\u1ED3 r\u1ED3i v\u1EC1 s\u1EDBm nha."
  - "\u0110i \u0111\u01B0\u1EDDng c\u1EA9n th\u1EADn, \u0111\u1EEBng \u0111\u1EC3
    r\u01A1i \u0111\u1ED3."
